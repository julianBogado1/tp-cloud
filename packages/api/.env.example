# Required: the user pool whose access tokens the API accepts.
# terraform output -raw cognito_user_pool_id / cognito_client_id
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=
# Needed for PUT /api/units/:id/config (setpoint) and GET /api/units/:id/shadow.
# Same -ats endpoint the simulator uses. Unset → those calls answer 503.
IOT_ENDPOINT=
# Origin allowed by CORS. "*" only for local dev; on EC2 use the S3 website URL.
CORS_ORIGIN=*
# Optional
PORT=3000
LIVE_POLL_MS=3000
DDB_TABLE=snowball-telemetry
AWS_REGION=us-east-1
